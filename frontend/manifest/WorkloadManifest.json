{
  "$schema": "https://learn.microsoft.com/fabric/workload-development-kit/manifest-schema/workload-manifest.schema.json",
  "workloadId": "Org.Orqentis",
  "name": "Org.Orqentis",
  "version": "0.7.0",
  "displayName": "Orqentis",
  "description": "Orqentis data contract enforcement platform.",
  "publisher": "Orqentis",
  "iconSmall": "icons/contract-16.svg",
  "iconLarge": "icons/contract-32.svg",
  "marketplace": {
    "tier": "community",
    "supportedRegions": ["australiaeast", "westeurope", "eastus"]
  },
  "items": [
    {
      "name": "Contract",
      "displayName": "Data Contract",
      "description": "An ODCS v3.1.0 data contract for any Fabric data source (Lakehouse, Warehouse, Eventhouse, Semantic Model, or Fabric SQL).",
      "iconSmall": "icons/contract-16.svg",
      "iconLarge": "icons/contract-32.svg",
      "capabilities": ["create", "edit", "delete", "run"],
      "definition": "items/ContractItem/ContractItem.json",
      "editor": { "path": "/contracts/editor" }
    },
    {
      "name": "ContractPolicy",
      "displayName": "Contract Policy",
      "description": "Enforcement policy + Activator routing for a contract.",
      "iconSmall": "icons/policy-16.svg",
      "iconLarge": "icons/policy-32.svg",
      "capabilities": ["create", "edit", "delete"],
      "definition": "items/ContractPolicyItem/ContractPolicyItem.json",
      "editor": { "path": "/contracts/policies" }
    },
    {
      "name": "ContractReport",
      "displayName": "Contract Report",
      "description": "Read-only enforcement run history for a contract.",
      "iconSmall": "icons/report-16.svg",
      "iconLarge": "icons/report-32.svg",
      "capabilities": ["view"],
      "definition": "items/ContractReportItem/ContractReportItem.json",
      "editor": { "path": "/contracts/runs" }
    }
  ],
  "extensionPoints": {
    "lakehouseContextMenu": [
      {
        "name": "createContractFromTable",
        "displayName": "Create data contract…",
        "icon": "icons/contract-16.svg",
        "action": { "path": "/contracts/new", "params": { "source": "lakehouse" } }
      }
    ]
  }
}
